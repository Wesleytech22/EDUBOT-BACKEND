PORT=4000

# Alternativa às 5 variáveis abaixo: cole aqui a Internal/External Database
# URL do Render (ou de qualquer provedor). Quando definida, tem prioridade
# sobre PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
DATABASE_URL=

PGHOST=localhost
PGPORT=5432
PGUSER=edubot
PGPASSWORD=edubot
PGDATABASE=edubot
# true ao conectar num Postgres gerenciado (Render, etc.) de fora da rede interna dele
PGSSL=false

# RNF-08 — segredo fora do código-fonte
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=30m

# Contas seed (RF-20 — sem sign-up público)
SEED_ADMIN_EMAIL=lumenforgeti@gmail.com
SEED_ADMIN_PASSWORD=EduBot@2026
SEED_EQUIPE_EMAIL=wealeyr537@gmail.com
SEED_EQUIPE_PASSWORD=EduBot@2026

# Pode listar várias origens separadas por vírgula (ex.: produção + preview).
CORS_ORIGIN=http://localhost:5173

# URL do frontend usada para montar o link de redefinição de senha enviado
# por e-mail. Em produção, defina com o domínio real do EDUBOT_FRONTEND
# (ex.: https://edubot.vercel.app) — sem barra final. Se não definida, usa
# a primeira origem de CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173

# E-mail transacional (fluxo "Esqueci minha senha").
#
# Em produção, use RESEND_API_KEY (envio via API HTTP — necessário porque
# hosts como o Render bloqueiam conexões SMTP de saída). Gere a chave em
# https://resend.com/api-keys. MAIL_FROM precisa usar um domínio verificado
# na Resend (https://resend.com/domains) para enviar a qualquer destinatário.
RESEND_API_KEY=

# Alternativa via SMTP real (funciona em hosts sem bloqueio de saída SMTP).
# Ignorado se RESEND_API_KEY estiver definida. Sem SMTP_HOST nem
# RESEND_API_KEY, cai numa conta Ethereal de teste (só para dev local).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduBot 🎓 <nao-responda@edubot.local>
