    "id": "sPCtekMhtu4pQ9IA",
    "name": "EduBot - Broadcast (mock WAHA)",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "broadcast",
          "responseMode": "onReceived",
          "options": {}
        },
        "id": "webhook-node",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          240,
          300
        ],
        "webhookId": "broadcast-edubot"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const body = $input.first().json.body;\nconst contacts = body.contacts || [];\nreturn contacts.map((c) => ({\n  json: {\n    logId: c.logId,\n    phone: c.phone,\n    name: c.name,\n    message: body.message,\n    callbackUrl: (body.callbackUrl || '')\n      .replace('127.0.0.1', 'host.docker.internal')\n      .replace('localhost', 'host.docker.internal'),\n  },\n}));"
        },
        "id": "code-expand",
        "name": "Montar lista de contatos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          460,
          300
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const ok = Math.random() > 0.1;\nreturn {\n  json: {\n    ...$json,\n    status: ok ? 'enviado' : 'falha',\n    detail: ok\n      ? `Simulado: mensagem enviada para ${$json.phone} (mock WAHA)`\n      : 'Simulado: falha no envio (mock WAHA)',\n  },\n};"
        },
        "id": "code-simulate",
        "name": "Simular envio (mock WAHA)",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          680,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{$json.callbackUrl}}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Webhook-Secret",
                "value": "={{ $env.EDUBOT_WEBHOOK_SECRET }}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ logId: $json.logId, status: $json.status, detail: $json.detail }) }}",
          "options": {}
        },
        "id": "http-callback",
        "name": "Callback status",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          900,
          300
        ]
      }
    ],
    "connections": {
